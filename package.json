{
  "name": "web-colocation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebXR multi-user colocation prototype (shared objects, pen, whiteboard)",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "dev:example": "COLO_CONFIG=examples/config.yaml vite",
    "build": "tsc && vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "gen:schema": "node scripts/gen-schema.ts",
    "hash-passcode": "node scripts/hash-passcode.ts",
    "make:sample-model": "node scripts/make-sample-model.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "iwer": "2.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
