{
  "name": "web-colocation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable WebXR meeting rooms: shared objects, pens, whiteboards and spatial voice for headsets and browsers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/web-colocation.git"
  },
  "keywords": [
    "webxr",
    "mixed-reality",
    "colocation",
    "meeting",
    "whiteboard",
    "three.js",
    "quest",
    "android-xr",
    "kubernetes"
  ],
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "dev:example": "COLO_CONFIG=examples/config.yaml vite",
    "build": "tsc && vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "gen:schema": "node scripts/gen-schema.ts",
    "hash-passcode": "node scripts/hash-passcode.ts",
    "make:sample-model": "node scripts/make-sample-model.ts",
    "gen:docs": "node scripts/gen-config-docs.ts",
    "gen": "node scripts/gen-schema.ts && node scripts/gen-config-docs.ts",
    "test:e2e": "npm run build && playwright test",
    "loadtest": "node scripts/loadtest.ts",
    "screenshots": "npm run build && node scripts/screenshots.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "iwer": "2.5.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
