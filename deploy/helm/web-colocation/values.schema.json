{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web-colocation Helm values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "server": {
          "default": {},
          "type": "object",
          "properties": {
            "publicUrl": {
              "description": "Public URL (e.g. https://xr.example.com). Its origin is always allowed for WebSockets.",
              "type": "string",
              "format": "uri"
            },
            "allowedOrigins": {
              "default": [],
              "description": "Extra allowed Origins for WebSocket connections. Same-host origins are always allowed.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "maxRooms": {
              "default": 500,
              "description": "Maximum number of rooms held in memory.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "trustForwardedFor": {
              "default": false,
              "description": "Trust X-Forwarded-For for rate limiting (only behind a proxy that overwrites it).",
              "type": "boolean"
            },
            "allowServerOverride": {
              "default": false,
              "description": "Allow the `?server=` URL parameter to point the client at another sync server.",
              "type": "boolean"
            },
            "csp": {
              "default": "report-only",
              "description": "Content-Security-Policy for the app page. Start with report-only, then enforce.",
              "type": "string",
              "enum": [
                "off",
                "report-only",
                "enforce"
              ]
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "default": {},
          "type": "object",
          "properties": {
            "mode": {
              "default": "none",
              "description": "none: anyone who can reach the app may join (rooms can still have passcodes). trusted-headers: identity comes from an authenticating proxy such as oauth2-proxy.",
              "type": "string",
              "enum": [
                "none",
                "trusted-headers"
              ]
            },
            "preset": {
              "default": "oauth2-proxy",
              "description": "Which identity headers to read. custom uses auth.headers.",
              "type": "string",
              "enum": [
                "oauth2-proxy",
                "custom"
              ]
            },
            "headers": {
              "default": {},
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "maxLength": 100
                },
                "email": {
                  "type": "string",
                  "maxLength": 100
                },
                "groups": {
                  "type": "string",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "additionalProperties": false
            },
            "allowDisplayNameOverride": {
              "default": false,
              "description": "Let SSO users change the display name shown to others.",
              "type": "boolean"
            },
            "admins": {
              "default": [],
              "description": "Emails that are hosts in every room.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 254
              }
            },
            "allowNonLoopback": {
              "default": false,
              "description": "Allow trusted-headers mode while listening on a non-loopback address (unsafe).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "branding": {
          "default": {},
          "type": "object",
          "properties": {
            "productName": {
              "default": "WebXR Colocation",
              "description": "Name shown in the lobby. A string or { en: ..., ja: ... }.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              ]
            },
            "logo": {
              "description": "Logo URL, e.g. /room-assets/logo.svg or an https URL.",
              "type": "string",
              "maxLength": 500
            },
            "accentColor": {
              "default": "#2f80ed",
              "description": "Accent colour of buttons and highlights.",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "lobbyMessage": {
              "description": "Text under the product name in the lobby.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "i18n": {
          "default": {},
          "type": "object",
          "properties": {
            "defaultLanguage": {
              "default": "en",
              "description": "UI language when the browser language is not supported.",
              "type": "string",
              "enum": [
                "en",
                "ja"
              ]
            }
          },
          "additionalProperties": false
        },
        "xr": {
          "default": {},
          "type": "object",
          "properties": {
            "inputProfilesPath": {
              "description": "Base URL of the WebXR input profiles (controller / hand models). Defaults to jsDelivr.",
              "type": "string",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "voice": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Offer voice chat (WebRTC, peer to peer).",
              "type": "boolean"
            },
            "iceServers": {
              "default": [
                {
                  "urls": "stun:stun.l.google.com:19302"
                }
              ],
              "description": "STUN/TURN servers with static credentials.",
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "urls": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "minItems": 1,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      }
                    ]
                  },
                  "username": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "credential": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "required": [
                  "urls"
                ],
                "additionalProperties": false
              }
            },
            "turn": {
              "type": "object",
              "properties": {
                "urls": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "description": "TURN URLs, e.g. turn:turn.example.com:3478?transport=udp."
                },
                "secretEnv": {
                  "default": "TURN_SECRET",
                  "description": "Environment variable holding the TURN REST shared secret (coturn static-auth-secret).",
                  "type": "string",
                  "maxLength": 100
                },
                "ttlSeconds": {
                  "default": 3600,
                  "description": "Lifetime of issued TURN credentials (refreshed automatically).",
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 86400
                }
              },
              "required": [
                "urls"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "default": {},
          "type": "object",
          "properties": {
            "driver": {
              "default": "memory",
              "description": "memory: state is lost on restart. file: one JSON file per room under storage.dir.",
              "type": "string",
              "enum": [
                "memory",
                "file"
              ]
            },
            "dir": {
              "default": "/data",
              "description": "Directory for the file driver (a persistent volume).",
              "type": "string",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "assets": {
          "default": {},
          "type": "object",
          "properties": {
            "dir": {
              "description": "Directory served at /room-assets/ (logos, GLB models...).",
              "type": "string",
              "maxLength": 500
            },
            "allowedOrigins": {
              "default": [],
              "description": "https origins models may be loaded from.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "maxModelBytes": {
              "default": 26214400,
              "description": "Largest glTF/GLB model (bytes) served and downloaded.",
              "type": "integer",
              "minimum": 1024,
              "maximum": 536870912
            }
          },
          "additionalProperties": false
        },
        "rooms": {
          "default": {},
          "type": "object",
          "properties": {
            "allowAdhoc": {
              "default": true,
              "description": "Allow joining any room name (created on demand from adhocTemplate).",
              "type": "boolean"
            },
            "adhocTemplate": {
              "default": "standard",
              "description": "Template for rooms created on demand.",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "adhocTtlHours": {
              "default": 168,
              "description": "Delete stored state of ad-hoc rooms unused for this long.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            },
            "list": {
              "default": [],
              "description": "Predefined rooms shown in the lobby.",
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
                    "description": "Room id used in URLs (?room=...)."
                  },
                  "title": {
                    "description": "Room title. A string or { en: ..., ja: ... }.",
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 200
                        }
                      }
                    ]
                  },
                  "template": {
                    "default": "standard",
                    "description": "Template id (built-in: standard, round-table, workshop, presentation).",
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
                  },
                  "overrides": {
                    "type": "object",
                    "properties": {
                      "environment": {
                        "type": "object",
                        "properties": {
                          "background": {
                            "default": "#dfe6ee",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "floor": {
                            "default": "grid",
                            "type": "string",
                            "enum": [
                              "grid",
                              "plain",
                              "none"
                            ]
                          },
                          "floorColor": {
                            "default": "#d4d9df",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "light": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5
                          }
                        },
                        "additionalProperties": false
                      },
                      "rules": {
                        "type": "object",
                        "properties": {
                          "maxParticipants": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 256
                          },
                          "voice": {
                            "type": "object",
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              }
                            },
                            "additionalProperties": false
                          },
                          "permissions": {
                            "type": "object",
                            "properties": {
                              "clearBoard": {
                                "type": "string",
                                "enum": [
                                  "everyone",
                                  "hosts"
                                ]
                              },
                              "resetObjects": {
                                "type": "string",
                                "enum": [
                                  "everyone",
                                  "hosts"
                                ]
                              },
                              "editSettings": {
                                "type": "string",
                                "enum": [
                                  "everyone",
                                  "hosts"
                                ]
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  "hosts": {
                    "default": [],
                    "description": "Emails of people who are hosts of this room (requires trusted-headers auth).",
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 254
                    }
                  },
                  "access": {
                    "type": "object",
                    "properties": {
                      "allowedDomains": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 253
                        }
                      },
                      "allowedUsers": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 254
                        }
                      },
                      "allowedGroups": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 256
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "passcodeHash": {
                    "description": "Hash from `npm run hash-passcode`. Overrides passcodes set by hosts in the app.",
                    "type": "string",
                    "pattern": "^scrypt\\$\\d+\\$\\d+\\$\\d+\\$[A-Za-z0-9+/=]+\\$[A-Za-z0-9+/=]+$"
                  },
                  "unlisted": {
                    "default": false,
                    "description": "Hide the room from the lobby list (people can still join by id).",
                    "type": "boolean"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "templates": {
          "default": [],
          "description": "Custom room templates (in addition to the built-in ones).",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
              },
              "extends": {
                "description": "Inherit everything from another template, then override the fields given here.",
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                ]
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "kind": {
                    "default": "table",
                    "type": "string",
                    "enum": [
                      "table",
                      "floor"
                    ]
                  },
                  "floorOffset": {
                    "default": 0.72,
                    "description": "Height of the shared origin above the floor. Use the main table height for 'table'.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3
                  }
                },
                "additionalProperties": false
              },
              "environment": {
                "type": "object",
                "properties": {
                  "background": {
                    "default": "#dfe6ee",
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "floor": {
                    "default": "grid",
                    "type": "string",
                    "enum": [
                      "grid",
                      "plain",
                      "none"
                    ]
                  },
                  "floorColor": {
                    "default": "#d4d9df",
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "light": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  }
                },
                "additionalProperties": false
              },
              "tables": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
                    },
                    "shape": {
                      "default": "rect",
                      "type": "string",
                      "enum": [
                        "rect",
                        "round"
                      ]
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.2,
                      "maximum": 20
                    },
                    "depth": {
                      "type": "number",
                      "minimum": 0.2,
                      "maximum": 20
                    },
                    "height": {
                      "default": 0.72,
                      "type": "number",
                      "minimum": 0.3,
                      "maximum": 1.5
                    },
                    "color": {
                      "default": "#b08d6a",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "x": {
                      "default": 0,
                      "type": "number",
                      "minimum": -50,
                      "maximum": 50
                    },
                    "z": {
                      "default": 0,
                      "type": "number",
                      "minimum": -50,
                      "maximum": 50
                    },
                    "yaw": {
                      "default": 0,
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    }
                  },
                  "required": [
                    "id",
                    "width"
                  ],
                  "additionalProperties": false
                }
              },
              "seats": {
                "anyOf": [
                  {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -50,
                          "maximum": 50
                        },
                        "z": {
                          "type": "number",
                          "minimum": -50,
                          "maximum": 50
                        },
                        "yaw": {
                          "description": "Facing direction in degrees (0 = looking towards -Z). Defaults to facing `lookAt` or the origin.",
                          "type": "number",
                          "minimum": -360,
                          "maximum": 360
                        },
                        "lookAt": {
                          "type": "array",
                          "items": [
                            {
                              "type": "number",
                              "minimum": -50,
                              "maximum": 50
                            },
                            {
                              "type": "number",
                              "minimum": -50,
                              "maximum": 50
                            }
                          ],
                          "additionalItems": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "x",
                        "z"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "auto": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64
                          },
                          "radius": {
                            "type": "number",
                            "minimum": 0.3,
                            "maximum": 20
                          },
                          "startAngle": {
                            "default": 0,
                            "description": "Angle of seat 0 in degrees, measured from +Z towards +X.",
                            "type": "number",
                            "minimum": -360,
                            "maximum": 360
                          }
                        },
                        "required": [
                          "count",
                          "radius"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "auto"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "boards": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
                    },
                    "x": {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 50
                    },
                    "y": {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 10
                    },
                    "z": {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 50
                    },
                    "yaw": {
                      "default": 0,
                      "description": "Degrees; 0 means the drawing surface faces +Z.",
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    },
                    "width": {
                      "default": 1.2,
                      "type": "number",
                      "minimum": 0.2,
                      "maximum": 10
                    },
                    "height": {
                      "default": 0.8,
                      "type": "number",
                      "minimum": 0.2,
                      "maximum": 10
                    },
                    "background": {
                      "default": "#fbfbf8",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    }
                  },
                  "required": [
                    "id",
                    "x",
                    "y",
                    "z"
                  ],
                  "additionalProperties": false
                }
              },
              "objects": {
                "description": "Replaces the inherited objects.",
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "cube",
                        "sphere",
                        "cone",
                        "torus",
                        "pen",
                        "model"
                      ]
                    },
                    "color": {
                      "default": "#9aa3ad",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "position": {
                      "type": "array",
                      "items": [
                        {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 100
                        },
                        {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 100
                        },
                        {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 100
                        }
                      ],
                      "additionalItems": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rotation": {
                      "default": [
                        0,
                        0,
                        0
                      ],
                      "description": "Euler angles in degrees (XYZ order).",
                      "type": "array",
                      "items": [
                        {
                          "type": "number",
                          "minimum": -360,
                          "maximum": 360
                        },
                        {
                          "type": "number",
                          "minimum": -360,
                          "maximum": 360
                        },
                        {
                          "type": "number",
                          "minimum": -360,
                          "maximum": 360
                        }
                      ],
                      "additionalItems": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 100
                    },
                    "model": {
                      "type": "object",
                      "properties": {
                        "src": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "scale": {
                          "default": 1,
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 100
                        },
                        "grabRadius": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 5
                        }
                      },
                      "required": [
                        "src"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "position"
                  ],
                  "additionalProperties": false
                }
